POSTGRES_DB=orate
POSTGRES_USER=orate
POSTGRES_PASSWORD=orate-development-only

# Used when running Orate directly on your computer.
DATABASE_URL=postgresql://orate:orate-development-only@localhost:5432/orate

# Used by containers through the Compose database hostname.
DOCKER_DATABASE_URL=postgresql://orate:orate-development-only@database:5432/orate